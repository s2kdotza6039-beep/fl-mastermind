# Studio Sensei — environment template.
# Copy to `.env` and fill in your Supabase project values (Dashboard → Settings → API).
# The publishable (anon) key is safe to expose in the client bundle.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# ── Server-side secrets (edge functions) ─────────────────────────────────────
# These are NOT client env vars. Set them in Supabase Dashboard → Edge Functions
# → Secrets (or `supabase secrets set …`). Never paste them into a repo or `.env`.
#
#   PADDLE_API_KEY=xxxxxxxx                 # Paddle → Developer tools → API keys
#   PADDLE_WEBHOOK_SECRET=xxxxxxxx          # Paddle → Developer tools → Notifications → Secret key
#   PADDLE_PRICE_ID=pri_xxxxxxxx            # Paddle "Price" for Pro $10/mo (USD)
#   APP_ORIGIN=https://your-app.example.com # Your public site URL (checkout redirect)

# ── Client-side (safe to expose in the bundle) ───────────────────────────────
# Paddle.js overlay checkout. The client-side token is public-by-design and only
# opens checkouts for prices configured in your Paddle account.
#   VITE_PADDLE_CLIENT_TOKEN="test_..."   # Paddle → Developer tools → API keys → Client-side keys
#   VITE_PADDLE_ENV="sandbox"             # "sandbox" for testing, "production" to go live
# Required for Paddle checkout to open (both overlay and payment link). Create it
# in Paddle after your account is verified (Developer tools → Authentication →
# Client-side tokens).
